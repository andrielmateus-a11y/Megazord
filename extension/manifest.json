{
  "manifest_version": 2,
  "name": "MEGAZORD Firefox Bridge",
  "version": "1.0.0",
  "description": "Conecta a MEGAZORD aos Firefox Containers e ao WhatsApp Web de cada canal (WA 01..WA 08).",
  "browser_specific_settings": {
    "gecko": { "id": "megazord-bridge@megazord.local", "strict_min_version": "115.0" }
  },
  "permissions": [
    "contextualIdentities",
    "cookies",
    "tabs",
    "storage",
    "alarms",
    "https://web.whatsapp.com/*"
  ],
  "background": { "scripts": ["background.js"], "persistent": true },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "browser_action": {
    "default_title": "MEGAZORD Bridge",
    "default_popup": "popup.html",
    "default_icon": "icons/icon.svg"
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" }
}
