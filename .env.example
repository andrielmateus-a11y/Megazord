# =====================================================================
# MEGAZORD — variáveis de ambiente (copie para .env e preencha)
# Nunca faça commit do .env. Nenhuma credencial é hardcoded no código.
# =====================================================================

# --- Servidor ---------------------------------------------------------
NODE_ENV=development
PORT=3001
# URL pública do backend (usada para montar o webhook da Evolution API)
PUBLIC_API_URL=http://localhost:3001
# Origens autorizadas a chamar a API (frontend). Separe por vírgula.
CORS_ORIGINS=http://localhost:5173
# Fuso usado para janelas de horário e limites diários
APP_TIMEZONE=America/Sao_Paulo
# Servir o build do frontend (dist/web) pelo próprio backend
SERVE_FRONTEND=true

# --- Banco de dados ---------------------------------------------------
# PostgreSQL / Supabase / Neon / Cloud SQL. Se vazio, usa PGlite (Postgres embarcado).
DATABASE_URL=
# DATABASE_SSL=false
# DATABASE_SSL_REJECT_UNAUTHORIZED=true
# Sem DATABASE_URL: pasta do PGlite em disco, ou "memory" para memória.
PGLITE_DATA_DIR=./data/pglite

# --- Segurança --------------------------------------------------------
# Chave para criptografar credenciais (AES-256-GCM). Mín. 32 caracteres em produção.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
# Segredo exigido nos webhooks (?token=...). Mín. 16 caracteres em produção.
WEBHOOK_SECRET=
SESSION_TTL_HOURS=72
# Permitir que novos usuários criem perfil sozinhos (o primeiro perfil sempre pode)
ALLOW_REGISTRATION=false

# --- Casa dos Dados ---------------------------------------------------
# Opcional: o administrador também pode cadastrar a chave pela interface (fica criptografada no banco).
CASA_DOS_DADOS_API_KEY=
CASA_DOS_DADOS_BASE_URL=https://api.casadosdados.com.br
CASA_DOS_DADOS_DAILY_LIMIT=500
CASA_DOS_DADOS_CACHE_TTL_HOURS=168
# Caminhos dos endpoints (ajuste se o fornecedor mudar de versão)
CASA_DOS_DADOS_SEARCH_PATH=/v5/cnpj/pesquisa
CASA_DOS_DADOS_DETAIL_PATH=/v4/cnpj/{cnpj}
CASA_DOS_DADOS_BALANCE_PATH=/v5/saldo

# --- "Tentar pela Receita" (sem chave) --------------------------------
BRASILAPI_URL=https://brasilapi.com.br
RECEITAWS_URL=https://receitaws.com.br

# --- Evolution API ----------------------------------------------------
# Opcional: também configurável pela interface (Configurações → WhatsApp).
EVOLUTION_API_URL=
EVOLUTION_API_KEY=

# --- Fila -------------------------------------------------------------
QUEUE_WORKER_ENABLED=true
QUEUE_TICK_MS=2000
QUEUE_SEND_TIMEOUT_MS=60000
BRIDGE_HEARTBEAT_TIMEOUT_MS=45000

# --- Frontend (Netlify) -----------------------------------------------
# URL do backend quando o frontend é publicado separado (Netlify). Vazio = mesmo domínio.
VITE_API_URL=
